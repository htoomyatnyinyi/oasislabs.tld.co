# Environment Configuration Template
# Copy this file to .env and fill in the values for your setup.

# Postgres / Neon Database Connection
DATABASE_URL="postgresql://username:password@ep-example.neon.tech/neondb?sslmode=require"

# Neon Auth Settings
NEON_AUTH_BASE_URL="https://ep-example.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth"
JWKS_URL="https://ep-example.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET="your-secret-cookie-key"