generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TeamMember {
  id          String   @id @default(uuid())
  name        String
  initials    String?  @db.VarChar(5)
  role        String
  location    String?
  experience  String?
  bio         String   @db.VarChar(255)
  fullBio     String?  @db.Text
  image       String?

  socials     Json?
  skills      String[]

  socialsList SocialLink[]
  skillsList  Skill[]
  posts       Post[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("team_members")
}

model SocialLink {
  id           String     @id @default(uuid())
  platform     Platform
  url          String
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, platform])
  @@map("social_links")
}

model Skill {
  id           String     @id @default(uuid())
  name         String
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, name])
  @@map("skills")
}

enum Platform {
  LINKEDIN
  TWITTER
  GITHUB
  WEBSITE
}

// ==========================================
// 2. SERVICES & TECHNOLOGIES (SHARED)
// ==========================================
model Service {
  id           String   @id @default(uuid())
  title        String   @unique
  slug         String?  @unique
  description  String   @db.Text
  icon         String
  isActive     Boolean  @default(true)

  features     String[]
  benefits     String[]
  technologies String[]
  process      String[]

  featuresList     ServiceFeature[]
  benefitsList     ServiceBenefit[]
  technologiesList ServiceTechnology[]
  processesList    ServiceProcess[]
  projectsList     ProjectService[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("services")
}

model ServiceFeature {
  id        String   @id @default(uuid())
  name      String
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, name])
  @@map("service_features")
}

model ServiceBenefit {
  id          String   @id @default(uuid())
  description String
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, description])
  @@map("service_benefits")
}

model ServiceProcess {
  id        String   @id @default(uuid())
  name      String
  order     Int
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, name])
  @@unique([serviceId, order])
  @@map("service_processes")
}

// Global Technology Model (Used by both Services and Projects)
model Technology {
  id       String              @id @default(uuid())
  name     String              @unique
  
  services ServiceTechnology[]
  projects ProjectTechnology[]

  @@map("technologies")
}

model ServiceTechnology {
  serviceId    String
  technologyId String
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([serviceId, technologyId])
  @@index([technologyId])
  @@map("service_technologies")
}

// ==========================================
// 3. PROJECTS / CASE STUDIES
// ==========================================
model Project {
  id               String   @id @default(uuid())
  title            String   @unique
  slug             String   @unique
  category         String
  description      String   @db.VarChar(255)
  fullDescription  String   @db.Text
  challenge        String   @db.Text
  solution         String   @db.Text
  summaryMetrics   String
  
  bgGradientFrom   String   @default("cyan-500/20")
  bgGradientTo     String   @default("blue-500/20")
  isFeatured       Boolean  @default(false)

  technologies     ProjectTechnology[]
  results          ProjectResult[]
  services         ProjectService[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("projects")
}

model ProjectResult {
  id        String   @id @default(uuid())
  label     String
  value     String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, label])
  @@map("project_results")
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technologies")
}

model ProjectService {
  projectId String
  serviceId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
  @@index([serviceId])
  @@map("project_services")
}

// ==========================================
// 4. FAQ
// ==========================================
model FaqCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String   @unique
  order     Int      @default(0)

  faqs      Faq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_categories")
}

model Faq {
  id         String   @id @default(uuid())
  question   String   @db.VarChar(500)
  answer     String   @db.Text
  order      Int      @default(0)
  isPinned   Boolean  @default(false)
  isActive   Boolean  @default(true)

  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, question])
  @@map("faqs")
}

// ==========================================
// 5. JOBS & CAREERS
// ==========================================
model Department {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String   @unique
  order     Int      @default(0)

  jobs      Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Job {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  location        String
  type            JobType        @default(FULL_TIME)
  isRemote        Boolean        @default(false)
  isActive        Boolean        @default(true)
  description     String         @db.Text
  
  salaryMin       Decimal?       @db.Decimal(12, 2)
  salaryMax       Decimal?       @db.Decimal(12, 2)
  salaryCurrency  String         @default("MMK")
  salaryOteString String?

  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  
  // Single relation mapped by Enum RequirementType to keep database clean
  requirementsAndTasks JobRequirementOrTask[]
  benefits             JobBenefit[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([departmentId])
  @@map("jobs")
}

model JobRequirementOrTask {
  id             String             @id @default(uuid())
  content        String             @db.VarChar(500)
  type           RequirementType
  order          Int                @default(0)
  
  jobId          String
  job            Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_requirements_and_tasks")
}

model JobBenefit {
  id        String   @id @default(uuid())
  content   String   @db.VarChar(255)
  order     Int      @default(0)
  
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_benefits")
}

model CompanyPerk {
  id          String   @id @default(uuid())
  icon        String
  title       String   @unique
  description String   @db.VarChar(500)
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_perks")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum RequirementType {
  RESPONSIBILITY
  REQUIREMENT
}

// ==========================================
// 6. BLOG
// ==========================================
model Post {
  id          String   @id @default(uuid())
  title       String   @unique
  slug        String   @unique
  excerpt     String   @db.VarChar(500)
  content     String   @db.Text
  image       String
  readTime    String
  publishedAt DateTime @default(now())
  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)

  authorId    String
  author      TeamMember @relation(fields: [authorId], references: [id], onDelete: Restrict)
  
  categoryId  String
  category    BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  tags        PostTag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  posts     Post[]

  @@map("blog_categories")
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  posts     PostTag[]

  @@map("tags")
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// ==========================================
// 7. TESTIMONIALS
// ==========================================
model Testimonial {
  id        String   @id @default(uuid())
  author    String
  role      String
  company   String?
  content   String   @db.Text
  rating    Int      @default(5)
  image     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

// ==========================================
// 8. PORTFOLIO ITEMS
// ==========================================
model PortfolioItem {
  id           String   @id @default(uuid())
  title        String
  description  String
  image        String
  category     String
  link         String?
  technologies String[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("portfolio_items")
}

// ==========================================
// 9. BLOG POSTS (SIMPLE)
// ==========================================
model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    @db.Text
  image       String
  author      String
  category    String
  publishedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("simple_blog_posts")
}

// ==========================================
// 10. CONTACT MESSAGES
// ==========================================
model ContactMessage {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  company   String?
  service   String?
  budget    String?
  message   String   @db.Text

  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// ==========================================
// 11. BOOKINGS
// ==========================================
model Booking {
  id          String   @id @default(uuid())
  name        String
  email       String
  company     String?
  message     String?  @db.Text
  meetingType String
  date        String
  time        String

  createdAt   DateTime @default(now())

  @@map("bookings")
}